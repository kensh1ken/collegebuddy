# Runtime
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/collegebuddy

# Authentication (use a random value of at least 32 characters in production)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=3d

# Comma-separated browser origins; never use * for an authenticated production API
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
TRUST_PROXY=false
SERVE_WEB_CLIENT=false

# Request protection
JSON_BODY_LIMIT=100kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Supabase server credentials (never expose the service key to either client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key
SUPABASE_RESOURCE_BUCKET=CBResources
SUPABASE_LOST_FOUND_BUCKET=CBLostFound
SIGNED_URL_TTL_SECONDS=300

# Uploads and moderation
MAX_RESOURCE_FILE_BYTES=10485760
MAX_IMAGE_FILE_BYTES=5242880
AUTO_APPROVE_RESOURCES=false

# Mobile client (place in mobile/campus-connect/.env for Expo)
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
